# Copy to .env.local and fill in. On Vercel, set the same keys in Project → Settings → Environment Variables.

# Public site origin used for Open Graph absolute URLs.
# On Vercel, production URL is inferred when this is empty.
NEXT_PUBLIC_SITE_URL=

# Contact delivery (server-only — never expose these as NEXT_PUBLIC_*)
# Inbox that receives portfolio messages (also used in the vCard QR).
CONTACT_TO_EMAIL=
# Phone digits for WhatsApp + vCard, country code included (no + or spaces).
# Example: 598991234567
CONTACT_PHONE_E164=
# Resend from address. Use onboarding@resend.dev until a domain is verified.
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
# https://resend.com/api-keys
RESEND_API_KEY=

# Cloudflare Turnstile — https://dash.cloudflare.com/ → Turnstile
# Local test (always passes): site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
# Production: create a widget for your Vercel domain (+ localhost if you want).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
